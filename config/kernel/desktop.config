# Kernel config fragment for AMD Ryzen and Intel Core (2020+) desktops.
# Installed to /etc/kernel/config.d/ and merged by sys-kernel/gentoo-kernel
# on top of the Gentoo distribution kernel config.

# CPU frequency: amd-pstate (active/EPP) on Zen 2 and newer, acpi-cpufreq
# fallback on Zen+, intel_pstate on Intel
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_CORETEMP=m
# Intel hybrid CPUs (12th gen+ P/E cores): hardware thread scheduling hints
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_SCHED_MC=y

# Desktop latency: 1000 Hz tick and full preemption (still switchable with preempt=)
CONFIG_HZ_1000=y
# CONFIG_HZ_300 is not set
# CONFIG_HZ_250 is not set
CONFIG_HZ=1000
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Graphics: amdgpu for Radeon and Ryzen iGPUs, i915 for Intel UHD/Iris Xe and
# Arc A-series, xe for Arc B-series (Battlemage) and Core Ultra graphics,
# simpledrm for the early console
CONFIG_DRM_AMDGPU=m
CONFIG_HSA_AMD=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_SIMPLEDRM=y

# Live system and installer
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=m
CONFIG_BTRFS_FS=m
CONFIG_ZRAM=m
CONFIG_NTFS3_FS=m
CONFIG_EXFAT_FS=m

# Virtualisation host (KVM)
CONFIG_KVM_AMD=m
CONFIG_KVM_INTEL=m

# Running as a virtual machine guest
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_VSOCKETS=m
# QEMU/KVM (virtio, SPICE/QXL, virtio-gpu with virgl)
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_SCSI_VIRTIO=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_INPUT=m
CONFIG_VIRTIO_FS=m
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_VIRTIO_VSOCKETS=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_QXL=m
CONFIG_DRM_BOCHS=m
# VMware (and VirtualBox VMSVGA graphics)
CONFIG_VMWARE_BALLOON=m
CONFIG_VMWARE_VMCI=m
CONFIG_VMWARE_VMCI_VSOCKETS=m
CONFIG_VMWARE_PVSCSI=m
CONFIG_VMXNET3=m
CONFIG_DRM_VMWGFX=m
# Hyper-V
CONFIG_HYPERV=m
CONFIG_HYPERV_UTILS=m
CONFIG_HYPERV_BALLOON=m
CONFIG_HYPERV_STORAGE=m
CONFIG_HYPERV_NET=m
CONFIG_HYPERV_KEYBOARD=m
CONFIG_HID_HYPERV_MOUSE=m
CONFIG_HYPERV_VSOCKETS=m
CONFIG_DRM_HYPERV=m
# VirtualBox
CONFIG_VBOXGUEST=m
CONFIG_VBOXSF_FS=m
# Xen (HVM/PVH guest)
CONFIG_XEN=y
CONFIG_XEN_PVHVM=y
CONFIG_XEN_PVH=y
CONFIG_XEN_BALLOON=y
CONFIG_HVC_XEN=y
CONFIG_XEN_BLKDEV_FRONTEND=m
CONFIG_XEN_NETDEV_FRONTEND=m
CONFIG_XEN_FBDEV_FRONTEND=m
CONFIG_INPUT_XEN_KBDDEV_FRONTEND=m
