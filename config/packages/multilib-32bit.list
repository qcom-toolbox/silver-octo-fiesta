# 32-bit (multilib) libraries, so 32-bit programs run on this 64-bit system:
# Steam (native, from the steam-overlay), Wine/Proton, Lutris, older games.
# Steam itself is NOT installed; get it from Discover (Flathub) or natively.
#
# Each package here is built for abi_x86_32 as well. Portage works out which of
# their dependencies need a 32-bit build too (see setup_multilib in
# scripts/chroot/build-system.sh). Skip all of this with build.sh --no-multilib.
# Same format as extras.list ("a | b" alternatives, missing ones only warn).

# Graphics: OpenGL, Vulkan, video decoding (NVIDIA's own 32-bit libraries are
# added automatically for the nvidia edition)
media-libs/mesa
media-libs/libglvnd
media-libs/vulkan-loader
media-libs/libva

# Sound
media-libs/alsa-lib
media-libs/libpulse
media-video/pipewire
media-libs/openal

# Input, windows, fonts
media-libs/libsdl2 | media-libs/sdl2-compat
dev-libs/wayland
x11-libs/libxkbcommon
x11-libs/libX11
x11-libs/libXext
x11-libs/libXrandr
x11-libs/libXinerama
x11-libs/libXcursor
x11-libs/libXi
x11-libs/libXcomposite
x11-libs/libXScrnSaver
x11-libs/libXtst
media-libs/freetype
media-libs/fontconfig

# System libraries games and Wine commonly load
dev-libs/glib
sys-apps/dbus
virtual/libudev
virtual/libusb
net-libs/gnutls
dev-libs/openssl
sys-libs/zlib
media-libs/libpng
