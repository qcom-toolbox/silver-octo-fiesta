# Running virtual machines ON this system (skip with build.sh --no-vm-host).
# Same format as extras.list: missing or unbuildable packages only warn.

# QEMU/KVM with libvirt and the virt-manager GUI
app-emulation/qemu
app-emulation/libvirt
app-emulation/virt-manager
# TPM 2.0 emulation for VMs, e.g. Windows 11 guests. (UEFI firmware for VMs,
# sys-firmware/edk2-bin, comes with QEMU in the exact version it needs.)
app-crypt/swtpm
# NAT networking of libvirt's "default" network
net-dns/dnsmasq
net-firewall/nftables

# VirtualBox host with its kernel modules (rebuilt with every distribution kernel)
app-emulation/virtualbox
app-emulation/virtualbox-modules
