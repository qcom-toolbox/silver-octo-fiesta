# Plasma desktop pieces
kde-plasma/plasma-meta bluetooth desktop-portal discover display-manager sddm flatpak gtk networkmanager pulseaudio wallpapers kwallet
kde-plasma/discover flatpak
kde-plasma/kwin lock screencast
x11-misc/sddm elogind -systemd

# Audio: PipeWire is the sound server (works on OpenRC through
# gentoo-pipewire-launcher started from XDG autostart).
media-video/pipewire sound-server extra

# Kernel, initramfs and boot
sys-kernel/installkernel dracut grub
sys-kernel/linux-firmware compress-zstd initramfs
sys-boot/grub mount
sys-fs/squashfs-tools zstd lz4 xz
sys-fs/lvm2 lvm -thin

# ZFS (installer option): sys-fs/zfs builds the kernel module itself (since
# ZFS 2.4) for every distribution kernel ("dist-kernel-cap" keeps the kernel
# within the versions ZFS supports); dracut module for a ZFS root
sys-fs/zfs dist-kernel modules rootfs

# Virtual machine host: QEMU with SPICE, USB redirection and 3D (virgl),
# libvirt with NAT networking, VirtualBox kernel modules for every kernel
app-emulation/qemu spice usbredir virgl opengl gtk pulseaudio pipewire
app-emulation/libvirt qemu virt-network libvirtd policykit
app-emulation/virt-manager gui
app-emulation/virtualbox-modules dist-kernel
net-dns/dnsmasq script
# swtpm (virtual TPM, e.g. for Windows 11 VMs) and virt-manager's viewer need these
net-libs/gnutls tools pkcs11
net-misc/spice-gtk usbredir

# VMware guest tools: with Mesa >= 25.2 "resolutionkms" requires Mesa and
# libdrm WITHOUT VMware graphics, which would drop 3D in VMware/VirtualBox
# guests. KWin already follows the VM window size through vmwgfx on Wayland.
app-emulation/open-vm-tools -resolutionkms

# The desktop profile enables "gpm" (console mouse) globally; on ncurses it
# makes a circular dependency (gpm needs ncurses) and is useless on a desktop.
sys-libs/ncurses -gpm

# Printing / discovery
net-print/cups zeroconf
# -gtk: avahi[gtk] -> gtk+[cups] -> cups[zeroconf] -> avahi is circular, and
# avahi's GTK browser is not needed on a KDE desktop
net-dns/avahi mdnsresponder-compat -gtk

# The graphical installer is written in Python + Qt 6
dev-python/pyside gui widgets
dev-python/pyside6 gui widgets
dev-python/PyQt6 gui widgets
dev-python/pyqt6 gui widgets

# Media
media-video/mpv vaapi vulkan wayland
media-video/ffmpeg vaapi vulkan

# Intel CPUs: install the microcode for every Intel CPU, not only the build host's
sys-firmware/intel-microcode -hostonly initramfs
